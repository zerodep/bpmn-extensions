{
  "name": "@0dep/bpmn-extensions",
  "version": "0.0.1",
  "description": "Flow extensions for bpmn-elements: FEEL expressions and the zeebe-namespace BPMN extension elements",
  "type": "module",
  "module": "src/index.js",
  "main": "dist/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "mocha",
    "test:lcov": "c8 -r lcov mocha && npm run lint",
    "test:md": "texample",
    "cov:html": "c8 mocha && c8 report --reporter html",
    "posttest": "npm run lint && npm run test:md && npm run prepack",
    "lint": "eslint . --cache && prettier . --check --cache",
    "format": "eslint . --fix && prettier . --write",
    "dist": "rollup -c",
    "types": "dts-buddy types/index.d.ts -m @0dep/bpmn-extensions:src/index.js",
    "prepack": "npm run dist && npm run types"
  },
  "keywords": [
    "bpmn",
    "bpmn-elements",
    "camunda",
    "camunda8",
    "zeebe",
    "feel",
    "extensions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodep/bpmn-extensions.git"
  },
  "author": {
    "name": "Pål Edman",
    "url": "https://github.com/paed01"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "bpmn-elements": ">=18.0.4"
  },
  "dependencies": {
    "feelin": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "bpmn-elements": "^18.0.4",
    "bpmn-moddle": "^9.0.1",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "debug": "^4.4.3",
    "dts-buddy": "^0.8.2",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "mocha": "^11.7.6",
    "mocha-cakes-2": "^3.3.0",
    "moddle-context-serializer": "^6.0.1",
    "prettier": "^3.9.1",
    "rollup": "^4.62.2",
    "texample": "^1.0.2",
    "typescript": "^6.0.3",
    "zeebe-bpmn-moddle": "^1.15.0"
  },
  "files": [
    "src",
    "dist",
    "types"
  ],
  "c8": {
    "exclude": [
      "dist",
      "test"
    ]
  }
}
