{
  "name": "@0dep/bpmn-extensions",
  "version": "1.0.1",
  "description": "Flow extensions for bpmn-elements: FEEL expressions and the zeebe-namespace BPMN extension elements",
  "type": "module",
  "main": "./src/index.js",
  "module": ".src/index.js",
  "browser": ".src/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "mocha",
    "test:lcov": "c8 -r lcov mocha && npm run lint",
    "test:md": "texample",
    "cov:html": "c8 mocha && c8 report --reporter html",
    "posttest": "npm run toc && npm run lint && npm run test:md && npm run prepack",
    "lint": "eslint . --cache && prettier . --check --cache",
    "toc": "toc -c README.md",
    "posttoc": "prettier --write README.md",
    "format": "eslint . --fix && prettier . --write",
    "types": "dts-buddy types/index.d.ts -m @0dep/bpmn-extensions:src/index.js",
    "prepack": "npm run types"
  },
  "keywords": [
    "bpmn",
    "bpmn-elements",
    "camunda",
    "camunda8",
    "zeebe",
    "feel",
    "extensions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodep/bpmn-extensions.git"
  },
  "author": {
    "name": "Zerodep AB",
    "url": "https://0dep.se"
  },
  "homepage": "https://0dep.se/run/",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "bpmn-elements": ">=18.0.25",
    "croner": ">=9"
  },
  "dependencies": {
    "feelin": "^8.1.0"
  },
  "overrides": {
    "mocha": {
      "yargs": "^18.1.0"
    }
  },
  "devDependencies": {
    "@0dep/toc": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "bpmn-elements": "^18.0.12",
    "bpmn-moddle": "^10.1.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "croner": "^10.0.1",
    "debug": "^4.4.3",
    "dts-buddy": "^0.8.2",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "mocha": "^12.0.3",
    "mocha-scenarios": "^1.0.1",
    "moddle-context-serializer": "^6.0.1",
    "prettier": "^3.9.1",
    "texample": "^1.0.2",
    "typescript": "^6.0.3",
    "zeebe-bpmn-moddle": "^2.0.0"
  },
  "files": [
    "src",
    "types",
    "CHANGELOG.md"
  ],
  "c8": {
    "exclude": [
      "test"
    ]
  }
}
