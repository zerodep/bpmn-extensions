{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "stripInternal": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.js"]
}
