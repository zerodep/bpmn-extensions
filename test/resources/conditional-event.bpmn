<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_conditional" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="conditional" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>to-fork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="to-fork" sourceRef="start" targetRef="fork" />
    <bpmn:parallelGateway id="fork">
      <bpmn:incoming>to-fork</bpmn:incoming>
      <bpmn:outgoing>to-approve</bpmn:outgoing>
      <bpmn:outgoing>to-wait-approved</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="to-approve" sourceRef="fork" targetRef="approve" />
    <bpmn:userTask id="approve" name="Approve">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= approved" target="approved" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>to-approve</bpmn:incoming>
      <bpmn:outgoing>approve-to-join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="to-wait-approved" sourceRef="fork" targetRef="wait-approved" />
    <bpmn:intermediateCatchEvent id="wait-approved" name="Wait for approval">
      <bpmn:incoming>to-wait-approved</bpmn:incoming>
      <bpmn:outgoing>wait-approved-to-join</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="wait-approved-condition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">= approved</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="approve-to-join" sourceRef="approve" targetRef="join" />
    <bpmn:sequenceFlow id="wait-approved-to-join" sourceRef="wait-approved" targetRef="join" />
    <bpmn:parallelGateway id="join">
      <bpmn:incoming>approve-to-join</bpmn:incoming>
      <bpmn:incoming>wait-approved-to-join</bpmn:incoming>
      <bpmn:outgoing>to-end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="to-end" sourceRef="join" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>to-end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_conditional">
    <bpmndi:BPMNPlane id="BPMNPlane_conditional" bpmnElement="conditional">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork">
        <dc:Bounds x="238" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="340" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait-approved_di" bpmnElement="wait-approved">
        <dc:Bounds x="372" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="348" y="325" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join">
        <dc:Bounds x="500" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="602" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="to-fork_di" bpmnElement="to-fork">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="238" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-approve_di" bpmnElement="to-approve">
        <di:waypoint x="263" y="195" />
        <di:waypoint x="263" y="140" />
        <di:waypoint x="340" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-wait-approved_di" bpmnElement="to-wait-approved">
        <di:waypoint x="263" y="245" />
        <di:waypoint x="263" y="300" />
        <di:waypoint x="372" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="approve-to-join_di" bpmnElement="approve-to-join">
        <di:waypoint x="440" y="140" />
        <di:waypoint x="525" y="140" />
        <di:waypoint x="525" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="wait-approved-to-join_di" bpmnElement="wait-approved-to-join">
        <di:waypoint x="408" y="300" />
        <di:waypoint x="525" y="300" />
        <di:waypoint x="525" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to-end_di" bpmnElement="to-end">
        <di:waypoint x="550" y="220" />
        <di:waypoint x="602" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
